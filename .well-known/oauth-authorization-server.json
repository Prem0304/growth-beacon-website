{
  "issuer": "https://growthbeacon.co.in",
  "authorization_endpoint": "https://app.growthbeacon.co.in/api/v1/auth/authorize",
  "token_endpoint": "https://app.growthbeacon.co.in/api/v1/auth/token",
  "jwks_uri": "https://app.growthbeacon.co.in/.well-known/jwks.json",
  "scopes_supported": [
    "read",
    "write",
    "leads:write",
    "audit:read",
    "services:read"
  ],
  "response_types_supported": [
    "code",
    "token"
  ],
  "grant_types_supported": [
    "authorization_code",
    "client_credentials",
    "refresh_token"
  ],
  "token_endpoint_auth_methods_supported": [
    "client_secret_post",
    "client_secret_basic",
    "none"
  ],
  "agent_auth": {
    "supported_methods": [
      "client_credentials",
      "bearer_token",
      "api_key"
    ],
    "registration_url": "https://growthbeacon.co.in/auth.md",
    "documentation": "https://growthbeacon.co.in/auth.md"
  }
}
